# ── Frontend ──────────────────────────────────────────────────────────────────
VITE_OPENAI_API_KEY=


# Use the SERVICE ROLE key (not the anon key) — needed for server-side writes
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJ...

# Free Census API key: https://api.census.gov/data/key_signup.html
CENSUS_API_KEY=

# Lemontree API key (optional — unlocks private fields: acceptingNewClients, flags)
# Without this the public API still works; reliability scores will use defaults for those fields
LEMONTREE_API_KEY=
