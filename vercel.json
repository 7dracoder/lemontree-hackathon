{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/ai",
      "destination": "/api/ai"
    },
    {
      "source": "/api/zip-demographics",
      "destination": "/api/zip-demographics"
    },
    {
      "source": "/api/placement-recommendations",
      "destination": "/api/placement-recommendations"
    },
    {
      "source": "/api/:path*",
      "destination": "https://platform.foodhelpline.org/api/:path*"
    },
    {
      "source": "/maps/:path*",
      "destination": "https://maps.googleapis.com/:path*"
    },
    {
      "source": "/((?!assets/|.*\\.).*)",
      "destination": "/index.html"
    }
  ]
}
